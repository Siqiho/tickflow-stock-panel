# ===== TickFlow =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | xai | codex_cli
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# 线上多用户 Hermes：默认使用服务器 Grok 订阅。
# 本地开发还可额外配置 86game / SubRouter，在「设置 → AI」里切换。
# 启用时把上面的 AI_PROVIDER / AI_MODEL 改为 xai / grok-4.5；AI_API_KEY
# 只允许作为部署 Secret，也可由服务器 OAuth 代替，不能交给 Profile 或用户端。
AI_ACCESS_MODE=self_hosted
AI_SUBSCRIPTION_ENABLED=false
AI_SUBSCRIPTION_PLAN=Grok
AI_86GAMESTORE_API_KEY=
AI_SUBROUTER_API_KEY=

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 首次启动时预置访问密码(可选)。公网服务器部署时填入,免去 SSH 端口转发设密码。
# 仅在尚未设置密码时生效(一次性初始化);设过后改密码请用页面 UI, 此处不再读取。
# 建议至少 6 位。.env 文件权限保持 600 且不要提交到 Git。
AUTH_PASSWORD=
# 仅填写会直接连接本应用、并覆盖 X-Forwarded-For 的受信任代理 IP；逗号分隔。
AUTH_TRUSTED_PROXY_IPS=
# 多用户公开注册默认开放；紧急关停时显式改为 false。
# 邀请码留空表示任何人均可注册；注册仍受单 IP 每日次数和总用户数限制。
PUBLIC_REGISTRATION_ENABLED=true
PUBLIC_REGISTRATION_INVITE_CODE=
PUBLIC_REGISTRATION_DAILY_PER_IP=3
PUBLIC_MAX_USERS=100
USER_AI_DAILY_QUOTA=20
USER_WATCHLIST_LIMIT=100
USER_SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# ===== Release identity =====
# 私人服务器设置为 private；BUILD_SHA 使用发布提交 SHA。
RELEASE_CHANNEL=development
BUILD_SHA=local

# Optional Docker build extras. Set to legacy-cpu on older VPS hosts
# without AVX2/FMA support.
BACKEND_EXTRAS=

# ===== Data =====
DATA_DIR=./data

# ===== Hermes Agent multi-user runtime =====
# 普通本地开发默认关闭；如启用，应让 `dev.sh` 监督独立的
# multiplex Runtime，使用不与个人 Hermes 冲突的本机端口。发布镜像会把
# RUNTIME_ENABLED 设为 true，并固定使用持久卷 /app/data/hermes。
ONE_TRADING_HERMES_RUNTIME_ENABLED=false
ONE_TRADING_HERMES_MULTIUSER_ENABLED=false
ONE_TRADING_HERMES_ROOT=./data/hermes
ONE_TRADING_HERMES_BASE_URL=http://127.0.0.1:8651
ONE_TRADING_HERMES_PROFILE=ot-owner
ONE_TRADING_HERMES_PYTHON=
# 本地开发可指向已安装的 Hermes 可执行文件和代码目录。
HERMES_RUNTIME_BIN=
HERMES_RUNTIME_CWD=
# 留空时自动使用 http://127.0.0.1:${PORT}，避免 Zeabur 动态端口不一致。
ONE_TRADING_INTERNAL_BASE_URL=
