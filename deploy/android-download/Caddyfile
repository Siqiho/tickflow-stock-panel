:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@apk path *.apk
	header @apk Content-Type "application/vnd.android.package-archive"
	header @apk Content-Disposition "attachment"

	respond /health "ok" 200
	file_server
}
