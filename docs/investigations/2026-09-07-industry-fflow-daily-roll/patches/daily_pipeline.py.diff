+def should_force_fail_stale_pipeline_job(
+    *,
+    in_flight: bool,
+    elapsed_s: float,
+    stale_after_s: float = 600,
+) -> bool:
+    """Fail a job_store row only when the worker is gone (reload orphan)."""
+    try:
+        elapsed = float(elapsed_s)
+    except (TypeError, ValueError):
+        return False
+    return elapsed > float(stale_after_s) and not bool(in_flight)
+
