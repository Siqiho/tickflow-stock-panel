+def _reset_pipeline_guard_for_tests() -> None:
+    global _PIPELINE_IN_FLIGHT
+    _PIPELINE_CANCEL.clear()
+    _PIPELINE_IN_FLIGHT = False
+    if _PIPELINE_GUARD.locked():
+        try:
+            _PIPELINE_GUARD.release()
+        except RuntimeError:
+            pass
